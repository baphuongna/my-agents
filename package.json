{
  "name": "mya",
  "version": "0.1.0",
  "private": true,
  "description": "Unified coding/autonomous agent (TypeScript 7 + Rust napi engine)",
  "license": "(MIT OR Apache-2.0)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "mya": "./dist/mya.js",
    "my-agent": "./packages/print/dist/cli.js"
  },
  "files": [
    "dist/mya.js",
    "packages/*/dist/**/*.js",
    "packages/*/package.json",
    "!packages/*/dist/**/*.test.js"
  ],
  "scripts": {
    "build": "tsc -b",
    "bundle": "node scripts/bundle.mjs",
    "dist": "npm run build && npm run bundle",
    "typecheck": "tsc --noEmit",
    "clean": "tsc -b --clean && rm -rf packages/*/dist",
    "natives:build": "cargo build -p my-agent-natives",
    "lint": "node scripts/lint.mjs",
    "lint:deps": "node scripts/lint-deps.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "ink-text-input": "^6.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.7.2",
    "@types/node": "^22.20.1",
    "typescript": "^7.0.2",
    "vitest": "^2.1.9"
  }
}
