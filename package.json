{
  "name": "mya",
  "piConfig": {
    "name": "mya",
    "configDir": ".mya"
  },
  "version": "0.1.0",
  "private": true,
  "description": "Unified coding/autonomous agent (TypeScript 7 + Rust napi engine)",
  "license": "(MIT OR Apache-2.0)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "mya": "./dist/mya.js",
    "my-agent": "./packages/print/dist/cli.js"
  },
  "files": [
    "dist/mya.js",
    "packages/*/dist/**/*.js",
    "packages/*/package.json",
    "!packages/*/dist/**/*.test.js"
  ],
  "scripts": {
    "build": "tsc -b",
    "bundle": "node scripts/bundle.mjs",
    "dist": "npm run build && npm run bundle",
    "typecheck": "tsc --noEmit",
    "clean": "tsc -b --clean && rm -rf packages/*/dist",
    "natives:build": "cargo build -p my-agent-natives",
    "desktop:dev": "cargo run -p my-agent-desktop-shell",
    "desktop:build": "cargo build --release -p my-agent-desktop-shell",
    "lint": "node scripts/lint.mjs",
    "lint:deps": "node scripts/lint-deps.mjs",
    "lint:rust": "cargo clippy --workspace --all-targets -- -D warnings",
    "lint:core-size": "node scripts/lint-core-size.mjs",
    "build:web": "vite build --config packages/web/vite.config.ts",
    "web:dev": "vite dev packages/web --config packages/web/vite.config.ts --port 5173",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "node -e \"import('@my-agent/eval').then(h => h.defaultHarness().grade().then(r => console.log(JSON.stringify(r, null, 2))))\"",
    "prepublishOnly": "npm run build && npm test && npm run bundle",
    "postinstall": "node scripts/apply-branding.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@earendil-works/pi-coding-agent": "^0.80.6",
    "@earendil-works/pi-tui": "^0.80.6",
    "@google/genai": "^2.11.0",
    "@mistralai/mistralai": "^2.4.1",
    "@nous-research/ui": "^1.5.2",
    "@opentelemetry/api": "^1.9.1",
    "@sinclair/typebox": "^0.34.52",
    "cross-spawn": "^7.0.6",
    "diff": "^9.0.0",
    "highlight.js": "^11.11.1",
    "hosted-git-info": "^10.1.1",
    "ignore": "^7.0.6",
    "ink-text-input": "^6.0.0",
    "jiti": "^2.7.0",
    "marked": "^18.0.6",
    "openai": "^6.46.0",
    "partial-json": "^0.1.7",
    "proper-lockfile": "^4.1.2",
    "typebox": "^1.1.38",
    "undici": "^8.7.0",
    "ws": "^8.18.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.7.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.1",
    "esbuild": "^0.21.5",
    "happy-dom": "^20.11.1",
    "jsdom": "^25.0.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vitest": "^2.1.9"
  }
}
