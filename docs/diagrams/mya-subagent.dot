digraph subagent_lifecycle {
    rankdir=TB;
    compound=true;
    fontname="Helvetica";
    fontsize=11;
    bgcolor="#fafafa";
    node [fontname="Helvetica", fontsize=10, style="filled,rounded", shape=box];
    edge [fontname="Helvetica", fontsize=8, color="#555555"];

    parent [label="Parent Agent\n\"refactor auth module\"", shape=oval, fillcolor="#a8d8ea"];
    
    subgraph cluster_spawn {
        label="SPAWN";
        fontsize=12; color="#e0e0e0"; style="filled,rounded"; fillcolor="#f5f5f5";
        
        acquire [label="POST /pool/acquire\n{role:'coder', task:'...',\n parentSessionId}", fillcolor="#cbf3d0"];
        childSid [label="Gateway returns\nchildSid", fillcolor="#cbf3d0"];
        view [label="herdrBackend.open()\n1. herdr pane split\n2. herdr pane current\n3. herdr pane run", fillcolor="#cbf3d0"];
        script [label="Bash script runs:\nmya --gateway-session $childSid\n--role coder --task '...'", fillcolor="#cbf3d0"];
    }

    subgraph cluster_child {
        label="CHILD (subagent in herdr pane)";
        fontsize=12; color="#e0e0e0"; style="filled,rounded"; fillcolor="#f5f5f5";
        
        boot [label="pi InteractiveMode boots\nmya-bridge extension loads", fillcolor="#ffcc99"];
        sessionStart [label="session_start event\n→ auto-inject task\n  as first prompt", fillcolor="#ffcc99"];
        turnStart [label="turn_start\n→ reportSubagentStatus('working')", fillcolor="#f9c0ab"];
        llm [label="LLM call + tool execution\n(read/edit/bash/...)", fillcolor="#d4a8e8"];
        settled [label="agent_settled\n→ reportSubagentStatus('done')", fillcolor="#b8e0d2"];
        exit [label="Process exits", fillcolor="#e8e8e8"];
    }

    subgraph cluster_gateway {
        label="GATEWAY /pool/tree";
        fontsize=12; color="#e0e0e0"; style="filled,rounded"; fillcolor="#f5f5f5";
        
        status [label="Status progression:\nidle → working → done", fillcolor="#a8d8ea"];
    }

    parent -> acquire;
    acquire -> childSid;
    childSid -> view;
    view -> script;
    script -> boot;
    boot -> sessionStart;
    sessionStart -> turnStart;
    turnStart -> llm;
    llm -> settled;
    settled -> exit;
    
    turnStart -> status [label="POST\n/pool/session/$id/status", fontsize=7, style=dashed, color="#888888"];
    settled -> status [label="POST\n/pool/session/$id/status", fontsize=7, style=dashed, color="#888888"];
    
    parent -> status [label="poll\n/pool/tree", fontsize=7, style=dashed, color="#888888", constraint=false];
}
