digraph agent_loop {
    rankdir=TB;
    compound=true;
    fontname="Helvetica";
    fontsize=11;
    bgcolor="#fafafa";
    node [fontname="Helvetica", fontsize=10, style="filled,rounded", shape=box];
    edge [fontname="Helvetica", fontsize=8, color="#555555"];

    start [label="User Prompt\n\"fix bug in auth.ts\"", shape=oval, fillcolor="#a8d8ea"];
    
    create [label="createAgent()\nwires: providers + memory\n+ tools + audit + skills", fillcolor="#cbf3d0"];
    
    turn [label="runTurn() — Turn FSM", fillcolor="#ffcc99", shape=diamond];
    
    stream [label="streamWithFallback()\ntry providers in order\ntaint failures", fillcolor="#d4a8e8"];
    
    parse [label="Parse LLM Response", fillcolor="#cbf3d0"];
    
    decision [label="Has tool calls?", shape=diamond, fillcolor="#ffcc99"];
    
    toolExec [label="dispatch.runTool()\n1. permission check\n2. human approval?\n3. impl.run()\n4. audit log", fillcolor="#f9c0ab"];
    
    toolResult [label="ToolResult\n{ ok, output }", fillcolor="#f9c0ab"];
    
    budget [label="Budget / rounds\ncheck", shape=diamond, fillcolor="#ffcc99"];
    
    compress [label="Idle-compaction\n(compress context\nif too long)", fillcolor="#e8e8e8"];
    
    response [label="Agent Response\ntext + tool results", shape=oval, fillcolor="#a8d8ea"];

    done [label="Turn Complete", shape=oval, fillcolor="#b8e0d2"];

    // Flow
    start -> create -> turn;
    turn -> stream [label="send messages\nto LLM", fontsize=8];
    stream -> parse;
    parse -> decision;
    
    decision -> toolExec [label="YES", fontsize=9, color="#2266aa"];
    toolExec -> toolResult;
    toolResult -> budget [label="feed result\nback to LLM", fontsize=8];
    budget -> turn [label="more rounds\n(≤25)", fontsize=8, color="#2266aa"];
    budget -> compress [label="context\ntoo long", fontsize=8, color="#aa6622"];
    compress -> turn;
    
    decision -> response [label="NO (text only)", fontsize=9, color="#22aa66"];
    response -> done;

    budget -> done [label="budget\nexhausted", fontsize=8, color="#aa2222"];

    // Memory side-effect (dashed)
    turn -> mem [label="record/recall", fontsize=7, style=dashed, color="#888888"];
    mem [label="Memory\nBrain + 14 Domains\n+ RRF retrieval", fillcolor="#b8e0d2", style="filled,rounded,dashed"];
}
