digraph transport_delivery {
    rankdir=LR;
    compound=true;
    fontname="Helvetica";
    fontsize=11;
    bgcolor="#fafafa";
    node [fontname="Helvetica", fontsize=10, style="filled,rounded", shape=box];
    edge [fontname="Helvetica", fontsize=8, color="#555555"];

    subgraph cluster_user {
        label="USER INTERFACES";
        fontsize=12; color="#e0e0e0"; style="filled,rounded"; fillcolor="#f5f5f5";

        terminal [label="Terminal\n(TUI)", fillcolor="#a8d8ea"];
        browser [label="Browser\n(Web Dashboard)", fillcolor="#a8d8ea"];
        ide [label="IDE\n(VS Code / Intercom)", fillcolor="#a8d8ea"];
        phone [label="Phone\n(WhatsApp / Matrix\n/ Signal / Push)", fillcolor="#a8d8ea"];
        cron_job [label="Cron\n(scheduled)", fillcolor="#a8d8ea"];
        api [label="API Client\n(JSON-RPC / HTTP)", fillcolor="#a8d8ea"];
    }

    subgraph cluster_transport {
        label="TRANSPORT MODES";
        fontsize=12; color="#e0e0e0"; style="filled,rounded"; fillcolor="#f5f5f5";

        tui_mode [label="pi InteractiveMode\n(full TUI)", fillcolor="#cbf3d0"];
        print_mode [label="Print mode\n(one-shot)", fillcolor="#cbf3d0"];
        rpc_mode [label="RPC server\n(JSON-RPC 2.0\nover stdio)", fillcolor="#cbf3d0"];
        serve_mode [label="serve mode\n(Gateway HTTP/WS\n+ web SPA)", fillcolor="#cbf3d0"];
        bg_mode [label="BG mode\n(TCP RPC)", fillcolor="#cbf3d0"];
        channel_mode [label="Channels\n(WA/Matrix/Signal\nadapters)", fillcolor="#cbf3d0"];
    }

    subgraph cluster_core {
        label="CORE";
        fontsize=12; color="#e0e0e0"; style="filled,rounded"; fillcolor="#f5f5f5";

        main [label="main.ts\n(mya binary)", fillcolor="#ffcc99"];
        agent [label="createAgent()\n→ runTurn()", fillcolor="#ffcc99"];
    }

    terminal -> tui_mode;
    terminal -> print_mode;
    browser -> serve_mode;
    ide -> rpc_mode;
    ide -> serve_mode;
    phone -> channel_mode;
    phone -> serve_mode [label="push\nnotif", fontsize=7, style=dashed];
    cron_job -> serve_mode [label="sweep\ntimer", fontsize=7, style=dashed];
    api -> rpc_mode;
    api -> serve_mode [label="HTTP\nREST", fontsize=7];
    api -> bg_mode;

    tui_mode -> main;
    print_mode -> main;
    rpc_mode -> main;
    serve_mode -> main;
    bg_mode -> main;
    channel_mode -> serve_mode [style=dashed];

    main -> agent;
}
