{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "my-agent",
  "version": "0.1.0",
  "identifier": "works.earendil.my-agent",
  "build": { "frontendDist": "../desktop-ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "my-agent",
        "width": 1024,
        "height": 768,
        "visible": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["myagent"]
      }
    }
  }
}